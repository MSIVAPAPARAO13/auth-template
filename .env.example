# ==============================================================================
# Django Authentication Platform — Environment Configuration Template
# Copy this file to .env and fill in your values for local or production use.
# NEVER commit the real .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Security & Core Django Settings
# ------------------------------------------------------------------------------
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# ------------------------------------------------------------------------------
# Database Settings (MySQL Default)
# ------------------------------------------------------------------------------
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=127.0.0.1
DB_PORT=3306

# ------------------------------------------------------------------------------
# OTP Delivery Mode
# Options:
#   demo       - Development simulator; displays instant code (123456) in UI banner
#   production - Dispatches real OTPs via configured Email, SMS, & WhatsApp providers
# ------------------------------------------------------------------------------
OTP_DELIVERY_MODE=demo

# ------------------------------------------------------------------------------
# Real Email Delivery (SMTP / Gmail App Password)
# ------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_character_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com
EMAIL_TIMEOUT=10

# ------------------------------------------------------------------------------
# Real SMS Delivery (Twilio)
# ------------------------------------------------------------------------------
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ------------------------------------------------------------------------------
# Real WhatsApp Delivery (Twilio WhatsApp)
# ------------------------------------------------------------------------------
WHATSAPP_PROVIDER=twilio
TWILIO_WHATSAPP_FROM=+14155238886
